<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Windows 11 app (WinUI 3, unpackaged and self-contained). The screens are built in C# without XAML files, so the
       whole app also compiles on Linux and macOS (dotnet build -p:EnableWindowsTargeting=true) to check it; it runs on
       Windows only. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>Typle</RootNamespace>
    <AssemblyName>Typle</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Typle.ico</ApplicationIcon>
    <!-- Program.cs is the entry point: it keeps one window, which a login's typle-r://login is handed to. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Typle.Core/Typle.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Messages\*.json" LogicalName="messages.%(Filename).json" />
    <Content Include="Assets\Typle.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- The build writes the app's resource index (Typle.pri, which holds WinUI's own control styles) beside Typle.exe, but
       dotnet publish only copies the files it knows of. Without it the app stops at its first screen ("Cannot locate
       resource from 'ms-appx:///Microsoft.UI.Xaml/Themes/themeresources.xaml'"). -->
  <Target Name="PublishProjectPriFile" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Include="$(ProjectPriFullPath)" Condition="'$(ProjectPriFullPath)' != '' and Exists('$(ProjectPriFullPath)')"
                             RelativePath="$(ProjectPriFileName)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
