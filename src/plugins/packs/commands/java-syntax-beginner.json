      "display": "protected int count;",
      "input": "protected int count;",
      "annotation": "protected：同一パッケージ・サブクラス向け（別パッケージのサブクラスからのアクセスには条件がある）"
    },
    {
      "display": "int count;",
      "input": "int count;",
      "annotation": "修飾子なし：同一パッケージ内（パッケージプライベート）"
