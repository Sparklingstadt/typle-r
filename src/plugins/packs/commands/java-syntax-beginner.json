      "display": "public class Main {\n  public static void main(String[] args) {\n    System.out.println(\"Hello, Java!\");\n  }\n}",
      "input": "public class Main { public static void main(String[] args) { System.out.println(\"Hello, Java!\"); } }",
      "annotation": "class：クラス定義（Main.javaに保存する例） / コード例の利用：断片を適切な場所へ配置（多くの例はメソッド内の断片。未定義変数・型・import等を補って利用）"
    },
    {
      "display": "public class Main {\n}",
      "input": "public class Main {}",
      "annotation": "public：外部に公開"
    },
    {
      "display": "static int count = 0;",
      "input": "static int count = 0;",
      "annotation": "static：インスタンスではなくクラスに属する（クラス内に記述）"
    },
    {
      "display": "void greet() {\n}",
      "input": "void greet() {}",
      "annotation": "void：戻り値なし"
    },
    {
      "display": "int age = 20;",
      "input": "int age = 20;",
      "annotation": ";：文の終わり（ブロックなど全構文の末尾に付けるわけではない） / 型 名前 = 値：変数の宣言と初期化"
    },
    {
      "display": "// コメント",
      "input": "// コメント",
      "annotation": "//：1行コメント"
    },
    {
      "display": "double rate = 0.5;",
      "input": "double rate = 0.5;",
      "annotation": "double：浮動小数点数の変数 / double：倍精度浮動小数点数"
    },
    {
      "display": "var age = 20;",
      "input": "var age = 20;",
      "annotation": "var：ローカル変数の型推論（動的型ではない。初期値が必要。通常のフィールド・メソッド引数型には使わない）"
    },
    {
      "display": "age = 21;",
      "input": "age = 21;",
      "annotation": "=：代入（宣言済み変数へ代入）"
    },
    {
      "display": "final int MAX = 100;",
      "input": "final int MAX = 100;",
      "annotation": "final：再代入禁止（参照先オブジェクトの内部変更まで禁止するわけではない）"
    },
    {
      "display": "double n = age;",
      "input": "double n = age;",
      "annotation": "拡大変換：対応する型へ暗黙に変換（型の組合せによっては精度が失われる）"
    },
    {
      "display": "int n = (int) 3.9;",
      "input": "int n = (int) 3.9;",
      "annotation": "(型) 値：明示的なキャスト（結果3。縮小変換では情報が失われ得る）"
    },
    {
      "display": "byte n = 10;",
      "input": "byte n = 10;",
      "annotation": "byte：8ビット符号付き整数"
    },
    {
      "display": "short n = 100;",
      "input": "short n = 100;",
      "annotation": "short：16ビット符号付き整数"
    },
    {
      "display": "int n = 100;",
      "input": "int n = 100;",
      "annotation": "int：32ビット符号付き整数"
    },
    {
      "display": "long n = 100L;",
      "input": "long n = 100L;",
      "annotation": "long：64ビット符号付き整数（Lはlongリテラル）"
    },
    {
      "display": "float rate = 0.5f;",
      "input": "float rate = 0.5f;",
      "annotation": "float：単精度浮動小数点数（fはfloatリテラル）"
    },
    {
      "display": "char c = 'A';",
      "input": "char c = 'A';",
      "annotation": "char：UTF-16コード単位（Unicodeの1文字すべてを1つのcharで表せるわけではない）"
    },
    {
      "display": "boolean ok = false;",
      "input": "boolean ok = false;",
      "annotation": "boolean：真偽値"
    },
    {
      "display": "count += 2;",
