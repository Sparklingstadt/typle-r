      "annotation": "++ / --：1増減（前置・後置では式の値が異なる）"
    },
    {
      "display": "int n = 1 << 3;",
      "input": "int n = 1 << 3;",
      "annotation": "<< >> >>>：ビットシフト（>>>はゼロ埋め右シフト）"
    },
    {
      "display": "return result;",
