    {
      "display": "private String name;",
      "input": "private String name;",
      "annotation": "private：宣言元の型の内部向け（同じトップレベル型に含まれる入れ子の型からのアクセス等は可能）"
    },
    {
      "display": "package example.app;",
      "input": "package example.app;",
      "annotation": "package：パッケージ宣言（通常はソース先頭に配置）"
    },
    {
      "display": "super.toString();",
      "input": "super.toString();",
      "annotation": "super.method()：親クラスの実装呼び出し"
