# Server-only settings. Put actual values in .env.local or Vercel.
DATABASE_URL=
# Optional direct connection for migrations (Neon).
DIRECT_URL=
POSTGRES_PASSWORD=
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_URL=http://localhost:3000

# Opt in only for a loopback development server; disabled in production.
LOCAL_DEVELOPMENT_LOGIN=0

# Optional LAN access: private IPv4 matching AUTH_URL; unset by default.
LOCAL_DEVELOPMENT_LAN_HOST=

# Sentry: unset DSNs disable error reporting. Public values are baked in at build.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Optional server DSN override; defaults to NEXT_PUBLIC_SENTRY_DSN.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
# Build-only source map upload settings. Never prefix the token with NEXT_PUBLIC_.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
