# Optional absolute URL of the site, for social preview images. Defaults to the Vercel production URL.
SITE_URL=

# Optional LAN access for `npm run dev:lan`: a private IPv4 of this machine; unset by default.
LOCAL_DEVELOPMENT_LAN_HOST=

# Sentry: unset DSNs disable error reporting. Public values are baked in at build.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Optional server DSN override; defaults to NEXT_PUBLIC_SENTRY_DSN.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
# Build-only source map upload settings. Never prefix the token with NEXT_PUBLIC_.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
