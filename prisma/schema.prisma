generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Workspace {
  ownerId   String   @id @map("owner_id") @db.Text
  devices   Json     @default("[]") @db.JsonB
  lists     Json     @default("[]") @db.JsonB
  packs     Json?    @db.JsonB
  interests Json?    @db.JsonB
  revision  Int      @default(1)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  // Whether the records are in typle_records rather than in the lists (each list's records is then empty).
  recordsSplit Boolean @default(false) @map("records_split")

  @@map("typle_workspaces")
}

// A practice record of a list, moved out of the list's records array. data is the record as the list held it, with its
// id; position is its place in that array and at its date, for paging.
model Record {
  ownerId  String   @map("owner_id") @db.Text
  listId   String   @map("list_id") @db.Text
  recordId String   @map("record_id") @db.Text
  position Int
  at       DateTime @db.Timestamptz(6)
  data     Json     @db.JsonB

  @@id([ownerId, listId, recordId])
  @@index([ownerId, listId, at(sort: Desc)], map: "typle_records_list_at")
  @@map("typle_records")
}

// A pack shared by link: data is a snapshot of the pack as a file (typle-pack v1), without records or the owner.
model SharedPack {
  id        String          @id @db.Uuid
  ownerId   String          @map("owner_id") @db.Text
  packId    String          @map("pack_id") @db.Text
  data      Json            @db.JsonB
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)
  // When the share was put in the gallery; NULL for a link-only share.
  listedAt  DateTime?       @map("listed_at") @db.Timestamptz(6)
  // When an admin hid the share; a hidden share is shown nowhere but to its owner.
  hiddenAt  DateTime?       @map("hidden_at") @db.Timestamptz(6)
  // How often the share was added to someone's packs while it was listed.
  addCount  Int             @default(0) @map("add_count")
  reports   GalleryReport[]

  @@unique([ownerId, packId], map: "typle_shared_packs_owner_pack")
  @@map("typle_shared_packs")
}

// A report of a listed share. The reporter's details are not kept.
model GalleryReport {
  id         String     @id @db.Uuid
  shareId    String     @map("share_id") @db.Uuid
  reason     String     @db.Text
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  sharedPack SharedPack @relation(fields: [shareId], references: [id], onDelete: Cascade)

  @@index([shareId], map: "typle_gallery_reports_share")
  @@map("typle_gallery_reports")
}

// When an account last signed out of every device: its sessions of a login no later than revokedAt are refused.
model SessionRevocation {
  ownerId   String   @id @map("owner_id") @db.Text
  revokedAt DateTime @default(now()) @map("revoked_at") @db.Timestamptz(6)

  @@map("typle_session_revocations")
}

// An account that may sign in to /admin. email is the FFPF ID account's email in lower case; ffpfSub is bound at the
// first sign-in and must match from then on.
model Admin {
  email      String    @id @db.Text
  ffpfSub    String?   @unique @map("ffpf_sub")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(6)

  @@map("typle_admins")
}
