{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "buildCommand": "npm run db:migrate && npm run build",
  "redirects": [
    { "source": "/api/auth/signin", "has": [{ "type": "host", "value": "typle-r-six\\.vercel\\.app" }], "destination": "https://typle.sparklingstadt.com/api/auth/signin", "permanent": false },
    { "source": "/", "has": [{ "type": "host", "value": "typle-r-six\\.vercel\\.app" }], "destination": "https://typle.sparklingstadt.com/", "permanent": true },
    { "source": "/:path((?!api/).*)", "has": [{ "type": "host", "value": "typle-r-six\\.vercel\\.app" }], "destination": "https://typle.sparklingstadt.com/:path", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/workspace", "destination": "/api/index" },
    { "source": "/api/workspace/records", "destination": "/api/index" },
    { "source": "/api/shares", "destination": "/api/index" },
    { "source": "/api/shared", "destination": "/api/index" },
    { "source": "/api/gallery", "destination": "/api/index" },
    { "source": "/api/gallery/:path*", "destination": "/api/index" },
    { "source": "/api/health", "destination": "/api/index" },
    { "source": "/api/auth/:path*", "destination": "/api/index" },
    { "source": "/api/admin/:path*", "destination": "/api/index" },
    { "source": "/api/graphql", "destination": "/api/index" }
  ]
}
